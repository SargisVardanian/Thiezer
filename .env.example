THIEZER_ENVIRONMENT=development
THIEZER_LOG_LEVEL=INFO
THIEZER_STORAGE_MODE=ephemeral
THIEZER_DATABASE_ENABLED=false
THIEZER_QUERY_TTL_SECONDS=1800
THIEZER_RESULT_TTL_SECONDS=1800
THIEZER_WEATHER_CACHE_TTL_SECONDS=900
THIEZER_ELEVATION_CACHE_TTL_SECONDS=86400
THIEZER_STAC_CACHE_TTL_SECONDS=3600
THIEZER_CATALOG_CACHE_TTL_SECONDS=86400
THIEZER_HORIZONS_CACHE_TTL_SECONDS=1800
THIEZER_OVERPASS_CACHE_TTL_SECONDS=3600
THIEZER_DATABASE_URL=postgresql+asyncpg://thiezer:thiezer@localhost:5432/thiezer
THIEZER_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
THIEZER_OPEN_METEO_API_KEY=
THIEZER_OVERPASS_ENABLED=true
THIEZER_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
THIEZER_OVERPASS_TIMEOUT_SECONDS=25
THIEZER_OVERPASS_LOCAL_RADIUS_KM=5
THIEZER_SURFACE_PROVIDER=procedural
THIEZER_DEM_COG_URL=
THIEZER_WORLDCOVER_COG_URL=
THIEZER_VIIRS_COG_URL=
THIEZER_EARTHDATA_TOKEN=
THIEZER_CORS_ALLOW_ALL=true
